# Storefront environment variables (Vite).
# Vite loads .env.development for `npm run dev` and .env.production for `npm run build`.
# Every VITE_* value is bundled into the public JavaScript, so never put secrets here.
# Personal overrides go in .env.local / .env.development.local (git-ignored).

# Express API base URL, no trailing slash.
VITE_BACKEND_SERVER_URL=http://localhost:3005

# Admin panel URL. Admins who log in on the storefront are sent here.
VITE_ADMIN_BASE_URL=http://localhost:5174

# Stripe publishable key. Must be the same mode (pk_test / pk_live) as the
# server's STRIPE_SECRET_KEY (sk_test / sk_live).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
