# Storefront environment variables (Vite).
#
# Vite loads:
#   .env.development  for `npm run dev`
#   .env.production   for `npm run build`
# Both files are git-ignored. To set them up, copy this file:
#   .env.development  = the DEVELOPMENT block below (already active)
#   .env.production   = the PRODUCTION block below (remove the leading "# ")
#
# Every VITE_* value is bundled into the public JavaScript, so never put
# secrets here. Personal overrides go in .env.local (also git-ignored).
#
# What each variable does:
#   VITE_BACKEND_SERVER_URL      Express API base URL, no trailing slash.
#   VITE_ADMIN_BASE_URL          Admin panel URL; admins who log in on the
#                                storefront are sent here.
#   VITE_STRIPE_PUBLISHABLE_KEY  Stripe publishable key. Must be the same mode
#                                (pk_test / pk_live) as the server's
#                                STRIPE_SECRET_KEY (sk_test / sk_live).

# ── DEVELOPMENT (.env.development) ──────────────────────────────────────────
VITE_BACKEND_SERVER_URL=http://localhost:3005
VITE_ADMIN_BASE_URL=http://localhost:5174
# This is the LIVE key, so local test payments charge real cards. Switch to a
# pk_test_ key once the local server uses an sk_test_ secret key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51OyP6VRoZLaKNG2s5fWIEp8pahjjBHB5nNRty3pLvbh1kT0vBJQQES68HMgft3yEzjJhLzg2Rljt0WPcwvG4Nghd00bPZh7zLv

# ── PRODUCTION (.env.production), deployed to https://elmaghrib.com ─────────
VITE_BACKEND_SERVER_URL=https://api.elmaghrib.com
VITE_ADMIN_BASE_URL=https://admin.elmaghrib.com
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51OyP6VRoZLaKNG2s5fWIEp8pahjjBHB5nNRty3pLvbh1kT0vBJQQES68HMgft3yEzjJhLzg2Rljt0WPcwvG4Nghd00bPZh7zLv
