# Admin panel environment variables (Vite).
#
# Vite loads:
#   .env.development  for `npm run dev`
#   .env.production   for `npm run build`
# Both files are git-ignored. To set them up, copy this file:
#   .env.development  = the DEVELOPMENT block below (already active)
#   .env.production   = the PRODUCTION block below (remove the leading "# ")
#
# Every VITE_* value is bundled into the public JavaScript, so never put
# secrets here. Personal overrides go in .env.local (also git-ignored).
#
# What each variable does:
#   VITE_BACKEND_SERVER_URL  Express API base URL, no trailing slash. Used by
#                            services/api.js, the notifications socket and
#                            most pages.
#   VITE_API_URL             Same API URL. Still read by the Login and
#                            Categories pages, so keep it identical.

# ── DEVELOPMENT (.env.development) ──────────────────────────────────────────
VITE_BACKEND_SERVER_URL=http://localhost:3005
VITE_API_URL=http://localhost:3005

# ── PRODUCTION (.env.production), deployed to https://admin.elmaghrib.com ───
# VITE_BACKEND_SERVER_URL=https://api.elmaghrib.com
# VITE_API_URL=https://api.elmaghrib.com
