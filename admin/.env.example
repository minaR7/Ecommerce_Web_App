# Admin panel environment variables (Vite).
# Vite loads .env.development for `npm run dev` and .env.production for `npm run build`.
# Every VITE_* value is bundled into the public JavaScript, so never put secrets here.
# Personal overrides go in .env.local / .env.development.local (git-ignored).

# Express API base URL, no trailing slash. Used by services/api.js, the
# notifications socket and most pages.
VITE_BACKEND_SERVER_URL=http://localhost:3005

# Same API URL. Still read by the Login and Categories pages, so keep it
# identical to VITE_BACKEND_SERVER_URL.
VITE_API_URL=http://localhost:3005
